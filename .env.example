# ============================================================
# BBT Corporativo - variaveis de ambiente
# ============================================================
# Copie para .env.local e preencha as chaves que for usar.
# A recomendacao desta versao: OpenAI GPT-5.2 como cerebro do sistema
# e Gemini apenas como motor auxiliar para Google Search/hoteis.

# ============================================================
# IA premium
# ============================================================

# OpenAI: cÃ©rebro principal, chat, leitura de texto/imagem, Ã¡udio e aÃ§Ãµes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_PRO_MODEL=gpt-5.2-pro
OPENAI_SEARCH_MODEL=gpt-5.2
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
AI_HOTEL_PROVIDER=openai

# Gemini: opcional, usado quando a tarefa pede Google Search/hoteis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# Tech Travel / TTravel Connect
# ============================================================
# A Tech passa a ser o provedor principal. Fornecedores aereos, hoteis,
# locadoras, operadoras e consolidadoras ficam habilitados dentro da conta Tech.
TECH_API_ENABLED=false
TECH_API_MODE=sandbox
TECH_API_BASE_URL=https://www.ttravel.com.br/ttravelapi/reservas
TECH_API_LOGIN=
TECH_API_PASSWORD=
TECH_API_KEY=
TECH_API_TIMEOUT_MS=30000
TECH_API_DEFAULT_COMPANY_ID=
TECH_API_DEFAULT_SYSTEMS=LATAM,GOLGWS,AZUL
TECH_API_HOTEL_SUPPLIERS=
TECH_API_TOKEN_CACHE_TTL_SECONDS=900

# API de relatorios. E independente da API de reservas acima e usa chave propria.
TECH_REPORTS_ENABLED=false
TECH_REPORTS_BASE_URL=https://www.ttravel.com.br/ttravelapi/relatorio
TECH_REPORTS_KEY=

# ============================================================
# Servidor / PostgreSQL compartilhado
# ============================================================
# O Next define NODE_ENV automaticamente: development em `next dev` e production em `next build/start`.
# Nao force NODE_ENV aqui, pois isso quebra o servidor de desenvolvimento.
PORT=3004
APP_URL=https://seu-dominio.com.br
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br

# Caminho persistente usado pelo servidor Windows. Mantenha fora de public/.
# Pode ser absoluto ou relativo a raiz do projeto.
BBT_STORAGE_FILE=.bbt-storage/app-kv.json

# Banco compartilhado para equipe.
DATABASE_URL=postgresql://bbt_user:SENHA_FORTE@127.0.0.1:5432/bbt_corporate
DATABASE_SSL=false
POSTGRES_POOL_MAX=10

# Login e protecao das APIs internas.
# Gere com: openssl rand -hex 32
AUTH_SECRET=
AUTH_REQUIRE_SESSION=true
BBT_SUPER_MASTER_PASSWORD=

# ============================================================
# WhatsApp/voz - provedores reais
# ============================================================
WHATSAPP_PROVIDER=evolution_api
WHATSAPP_API_BASE_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_ID=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
