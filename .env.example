# BBT Corporativo - modelo de ambiente
# Nunca grave valores reais neste arquivo ou no repositorio.

# Aplicacao
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=https://corporativo.seu-dominio.com.br
NEXT_PUBLIC_APP_URL=https://corporativo.seu-dominio.com.br
APP_VERSION=
ALLOW_INSECURE_LOCALHOST=false
LOG_LEVEL=info

# PostgreSQL
# A aplicacao usa papel sem SUPERUSER/BYPASSRLS; migrations usam a conta administrativa.
DATABASE_URL=postgresql://bbt_app:CHANGE_ME@postgres:5432/bbt_corporativo
MIGRATION_DATABASE_URL=postgresql://bbt_admin:CHANGE_ME@postgres:5432/bbt_corporativo
DATABASE_APP_ROLE=bbt_app
DATABASE_APP_PASSWORD=
DATABASE_SSL=false
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_DB=bbt_corporativo
POSTGRES_USER=bbt_admin
POSTGRES_PASSWORD=

# Autenticacao e sessao
# Gere AUTH_SECRET com pelo menos 32 bytes aleatorios.
AUTH_SECRET=
AUTH_SESSION_HOURS=12
AUTH_COOKIE_NAME=bbt_session

# Arquivos privados persistentes
STORAGE_ROOT=/var/lib/bbt/files
MAX_UPLOAD_BYTES=15728640

# E-mail transacional
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=BBT Corporativo
PASSWORD_RESET_MINUTES=30

# Bootstrap inicial, executado uma unica vez apos as migrations
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_PLATFORM_ADMIN=true
BOOTSTRAP_PLAN_KEY=
BOOTSTRAP_PLAN_NAME=
BOOTSTRAP_MAX_USERS=
BOOTSTRAP_MAX_STORAGE_BYTES=
BOOTSTRAP_MAX_MONTHLY_OPERATIONS=
BOOTSTRAP_ENTITLEMENTS={}

# Inteligencia artificial
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_PRO_MODEL=gpt-5.2-pro
OPENAI_SEARCH_MODEL=gpt-5.2
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_HOTEL_PROVIDER=openai

# Tech Travel / TTravel Connect
TECH_API_ENABLED=false
TECH_API_MODE=production
TECH_API_BASE_URL=https://www.ttravel.com.br/ttravelapi/reservas
TECH_API_LOGIN=
TECH_API_PASSWORD=
TECH_API_KEY=
TECH_API_TIMEOUT_MS=30000
TECH_API_DEFAULT_COMPANY_ID=
TECH_API_DEFAULT_SYSTEMS=
TECH_API_HOTEL_SUPPLIERS=
TECH_API_TOKEN_CACHE_TTL_SECONDS=900
TECH_REPORTS_ENABLED=false
TECH_REPORTS_BASE_URL=https://www.ttravel.com.br/ttravelapi/relatorio
TECH_REPORTS_KEY=

# WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=evolution_api
WHATSAPP_API_BASE_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_ID=
