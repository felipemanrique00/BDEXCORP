# BDEX - staging isolado
# Copie para .env.staging somente no servidor. Nunca grave valores reais no Git.

APP_ENVIRONMENT=staging
APP_URL=https://staging.bdextravel.com.br
NEXT_PUBLIC_APP_URL=https://staging.bdextravel.com.br
NEXT_PUBLIC_OFFLINE_TRAVEL_ENABLED=true
APP_VERSION=
BBT_IMAGE=bbt-corporativo-staging
LOG_LEVEL=info

POSTGRES_DB=bbt_corporativo_staging
POSTGRES_USER=bbt_staging_admin
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://bbt_staging_app:CHANGE_ME@staging_postgres:5432/bbt_corporativo_staging
MIGRATION_DATABASE_URL=postgresql://bbt_staging_admin:CHANGE_ME@staging_postgres:5432/bbt_corporativo_staging
DATABASE_APP_ROLE=bbt_staging_app
DATABASE_APP_PASSWORD=
DATABASE_SSL=false
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=30000

AUTH_SECRET=
AUTH_SESSION_HOURS=12
AUTH_COOKIE_NAME=bbt_session_staging
MFA_ENCRYPTION_KEY=
MFA_ADMIN_REQUIRED=true
MFA_ISSUER=BBT Corporativo Staging
MFA_CHALLENGE_MINUTES=10
MFA_MAX_ATTEMPTS=6

AUTOMATION_WORKER_ENABLED=true
AUTOMATION_WORKER_INTERVAL_MS=5000
AUTOMATION_WORKER_BATCH_SIZE=25

MAX_UPLOAD_BYTES=15728640

# As integracoes reais permanecem bloqueadas no Compose de staging.
SMTP_ENABLED=false
WHATSAPP_ENABLED=false
TECH_API_ENABLED=false
TECH_REPORTS_ENABLED=false

BOOTSTRAP_TENANT_NAME=BDEX Homologacao
BOOTSTRAP_TENANT_SLUG=bdex-homologacao
BOOTSTRAP_ADMIN_NAME=Administrador de Homologacao
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_PLATFORM_ADMIN=true
BOOTSTRAP_PLAN_KEY=staging
BOOTSTRAP_PLAN_NAME=Staging
BOOTSTRAP_MAX_USERS=50
BOOTSTRAP_MAX_STORAGE_BYTES=1073741824
BOOTSTRAP_MAX_MONTHLY_OPERATIONS=10000
BOOTSTRAP_ENTITLEMENTS={}
